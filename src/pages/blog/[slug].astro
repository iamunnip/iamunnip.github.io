---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => import.meta.env.PROD ? !data.draft : true);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const dateFormatter = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title={`${post.data.title} - Unni P`} description={post.data.description}>
  <Navbar />
  <main id="main-content">
    <article class="min-h-screen pt-32 pb-24 px-6">
      <div class="max-w-3xl mx-auto">
        <a href="/blog" class="text-neon-blue text-sm hover:text-accent transition-colors">&larr; Back to Blog</a>

        <h1 class="text-3xl sm:text-4xl font-bold mt-6 mb-4 synth-glow-text">{post.data.title}</h1>

        <div class="flex flex-wrap items-center gap-4 mb-10">
          <time datetime={post.data.pubDate.toISOString()} class="font-sans text-xs text-text-secondary">
            {dateFormatter.format(post.data.pubDate)}
          </time>
          {post.data.tags.length > 0 && (
            <div class="flex flex-wrap gap-2">
              {post.data.tags.map((tag) => (
                <span class="px-2 py-0.5 text-xs font-sans text-teal bg-teal/5 border border-teal/15 rounded">
                  {tag}
                </span>
              ))}
            </div>
          )}
        </div>

        <div class="prose-content text-text-primary leading-relaxed">
          <Content />
        </div>
      </div>
    </article>
  </main>
  <Footer />
</BaseLayout>

<style>
  .prose-content :global(h2) {
    font-size: 1.5rem;
    font-weight: 700;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }
  .prose-content :global(h3) {
    font-size: 1.25rem;
    font-weight: 700;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }
  .prose-content :global(p) {
    margin-bottom: 1rem;
  }
  .prose-content :global(ul),
  .prose-content :global(ol) {
    margin-bottom: 1rem;
    padding-left: 1.5rem;
  }
  .prose-content :global(li) {
    margin-bottom: 0.5rem;
  }
  .prose-content :global(a) {
    color: var(--color-neon-blue);
    text-decoration: underline;
  }
  .prose-content :global(code) {
    font-family: monospace;
    background: var(--color-surface-light);
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    font-size: 0.875em;
  }
  .prose-content :global(pre) {
    background: var(--color-surface);
    border: 1px solid var(--color-surface-light);
    border-radius: 0.5rem;
    padding: 1rem;
    overflow-x: auto;
    margin-bottom: 1rem;
  }
  .prose-content :global(pre code) {
    background: none;
    padding: 0;
  }
  .prose-content :global(blockquote) {
    border-left: 2px solid var(--color-accent);
    padding-left: 1rem;
    color: var(--color-text-secondary);
    margin-bottom: 1rem;
  }
</style>
