---
// Shared wrapper for rendered Markdown/MDX content (blog posts, project pages).
---

<div class="prose-content text-text-primary leading-relaxed">
  <slot />
</div>

<style>
  .prose-content :global(h2) {
    font-size: 1.5rem;
    font-weight: 700;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }
  .prose-content :global(h3) {
    font-size: 1.25rem;
    font-weight: 700;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }
  .prose-content :global(p) {
    margin-bottom: 1rem;
  }
  .prose-content :global(ul),
  .prose-content :global(ol) {
    margin-bottom: 1rem;
    padding-left: 1.5rem;
  }
  .prose-content :global(ul) {
    list-style-type: disc;
  }
  .prose-content :global(ol) {
    list-style-type: decimal;
  }
  .prose-content :global(ul ul) {
    list-style-type: circle;
    margin-top: 0.5rem;
  }
  .prose-content :global(li::marker) {
    color: var(--color-accent);
  }
  .prose-content :global(li) {
    margin-bottom: 0.5rem;
  }
  .prose-content :global(a) {
    color: var(--color-neon-blue);
    text-decoration: underline;
  }
  .prose-content :global(code) {
    font-family: monospace;
    background: var(--color-surface-light);
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    font-size: 0.875em;
  }
  .prose-content :global(pre) {
    background: var(--color-surface);
    border: 1px solid var(--color-surface-light);
    border-radius: 0.5rem;
    padding: 1rem;
    overflow-x: auto;
    margin-bottom: 1rem;
  }
  .prose-content :global(pre code) {
    background: none;
    padding: 0;
  }
  .prose-content :global(table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    margin-bottom: 1rem;
    font-size: 0.9375rem;
  }
  .prose-content :global(th),
  .prose-content :global(td) {
    border: 1px solid var(--color-surface-light);
    padding: 0.5rem 0.75rem;
    text-align: left;
    vertical-align: top;
  }
  .prose-content :global(th) {
    background: var(--color-surface);
    font-weight: 600;
  }
  .prose-content :global(blockquote) {
    border-left: 2px solid var(--color-accent);
    padding-left: 1rem;
    color: var(--color-text-secondary);
    margin-bottom: 1rem;
  }
</style>
