---

<section id="experience" class="py-24 px-6 bg-surface/30">
  <div class="max-w-6xl mx-auto">
    <h2 class="text-3xl sm:text-4xl font-bold mb-4 synth-glow-text">Work <span class="text-gradient">Experience</span></h2>
    <p class="text-text-secondary max-w-2xl mb-16">
      A timeline of my professional journey building and operating production systems.
    </p>

    <div class="relative">
      <div class="absolute left-4 md:left-6 top-0 bottom-0 w-px bg-gradient-to-b from-accent via-neon-blue to-transparent"></div>

      <div class="space-y-12">
        {experiences.map((exp, i) => (
          <div class="relative pl-12 md:pl-16">
            <div class={`absolute left-2.5 md:left-4.5 top-1.5 w-3 h-3 rounded-full border-2 z-10 ${i === 0 ? 'bg-accent border-accent shadow-[0_0_10px_rgba(255,42,109,0.6)]' : 'bg-primary border-neon-blue/50'}`}></div>

            <div class="synth-border rounded-xl p-6 transition-all duration-300">
              <div class="flex flex-wrap items-start justify-between gap-2 mb-3">
                <div>
              <h3 class="text-xl font-bold text-text-primary">{exp.role}</h3>
              <p class="text-accent font-medium">{exp.company}</p>
              {exp.location && <p class="text-neon-blue text-xs mt-1">{exp.location}</p>}
                </div>
                <span class="font-mono text-xs text-text-secondary bg-surface-light/50 px-3 py-1 rounded-full">
                  {exp.period}
                </span>
              </div>

              <p class="text-text-secondary text-sm mb-4">{exp.description}</p>

              <ul class="space-y-2 mb-4">
                {exp.highlights.map((item) => (
                  <li class="flex items-start gap-2 text-sm text-text-secondary">
                    <span class="text-neon-blue mt-1 flex-shrink-0">▸</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>

              <div class="flex flex-wrap gap-2">
                {exp.tags.map((tag) => (
                  <span class="px-2 py-0.5 text-xs font-mono text-accent/80 bg-accent/5 border border-accent/20 rounded">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
